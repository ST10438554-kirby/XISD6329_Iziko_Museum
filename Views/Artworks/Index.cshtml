@model IEnumerable<IzikoMuseumWebsite.Models.Artwork>

@{
    ViewData["Title"] = "Artwork Collection";
}

<!-- ============================= -->
<!-- ARTWORK HEADER -->
<!-- ============================= -->

<section class="artwork-heading">
    <div class="container">

        <span class="artwork-eyebrow">
            IZIKO ART GALLERY
        </span>

        <h1>
            Artwork Collection
        </h1>

        <p>
            Explore remarkable artworks from South Africa,
            Africa and beyond.
        </p>

    </div>
</section>


<!-- ============================= -->
<!-- ARTWORK COLLECTION -->
<!-- ============================= -->

<section class="artwork-section">

    <div class="container">

        <div class="artwork-grid">

            <!-- BUTCHER BOYS -->

            <div class="artwork-card">

                <div class="artwork-image">

                    <img src="/images/artwork/butcherboys.jpg"
                         alt="The Butcher Boys by Jane Alexander"
                         onerror="this.style.display='none';" />

                </div>

                <div class="artwork-content">

                    <span class="artwork-category">
                        SCULPTURE
                    </span>

                    <h2>
                        The Butcher Boys
                    </h2>

                    <h4>
                        Jane Alexander
                    </h4>

                    <p>
                        <strong>1985–1986</strong>
                    </p>

                    <p>
                        Butcher Boys is a sculpture by South African
                        artist Jane Alexander consisting of three
                        life-size humanoid figures seated on a bench.
                        The work responds to the political and social
                        conditions of South Africa during the state
                        of emergency.
                    </p>

                    <a asp-controller="Artworks"
                       asp-action="Details"
                       asp-route-id="1"
                       class="artwork-button">

                        View Artwork →

                    </a>

                </div>

            </div>


            <!-- FIVE THEMES -->

            <div class="artwork-card">

                <div class="artwork-image">

                    <img src="/images/artwork/fivethemes.jpg"
                         alt="William Kentridge Five Themes"
                         onerror="this.style.display='none';" />

                </div>

                <div class="artwork-content">

                    <span class="artwork-category">
                        EXHIBITION
                    </span>

                    <h2>
                        William Kentridge: Five Themes
                    </h2>

                    <h4>
                        William Kentridge
                    </h4>

                    <p>
                        <strong>Contemporary Art</strong>
                    </p>

                    <p>
                        Five Themes is a comprehensive survey of
                        William Kentridge's work. The exhibition
                        brings together animated films, drawings,
                        prints, theatre models, sculptures and books,
                        exploring major themes throughout his career.
                    </p>

                    <a asp-controller="Artworks"
                       asp-action="Details"
                       asp-route-id="2"
                       class="artwork-button">

                        View Artwork →

                    </a>

                </div>

            </div>


            <!-- BREAKING DOWN THE WALLS -->

            <div class="artwork-card">

                <div class="artwork-image">

                    <img src="/images/artwork/breakingdownwalls.jpg"
                         alt="Breaking Down the Walls exhibition"
                         onerror="this.style.display='none';" />

                </div>

                <div class="artwork-content">

                    <span class="artwork-category">
                        EXHIBITION
                    </span>

                    <h2>
                        Breaking Down the Walls
                    </h2>

                    <h4>
                        Iziko Museums of South Africa
                    </h4>

                    <p>
                        <strong>2023</strong>
                    </p>

                    <p>
                        Breaking Down the Walls commemorated 150 years
                        of collecting at Iziko. The exhibition explored
                        African heritage, culture, art and identity,
                        including the launch of an artist-in-residence
                        programme and the Phetoho Collection.
                    </p>

                    <a asp-controller="Artworks"
                       asp-action="Details"
                       asp-route-id="3"
                       class="artwork-button">

                        View Artwork →

                    </a>

                </div>

            </div>

        </div>

    </div>

</section>