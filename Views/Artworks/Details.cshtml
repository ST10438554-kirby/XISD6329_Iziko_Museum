@model IzikoMuseumWebsite.Models.Artwork

@{
    ViewData["Title"] = Model.Title;
}

<div class="container py-5">

    <div class="row g-5">

        <!-- ARTWORK IMAGE -->

        <div class="col-md-6">

            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl"
                     alt="@Model.Title"
                     class="img-fluid rounded shadow"
                     style="width:100%; max-height:600px; object-fit:cover;" />
            }
            else
            {
                <div class="d-flex align-items-center justify-content-center bg-light rounded"
                     style="height:500px;">

                    <span class="text-muted">
                        No image available
                    </span>

                </div>
            }

        </div>


        <!-- ARTWORK INFORMATION -->

        <div class="col-md-6">

            <h1 class="display-5 fw-bold">
                @Model.Title
            </h1>


            @if (Model.Artist != null)
            {
                <h4 class="text-muted mb-4">
                    @Model.Artist.Name
                </h4>
            }


            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <p class="lead">
                    @Model.Description
                </p>
            }


            <hr />


            @if (Model.YearCreated != null)
            {
                <p>
                    <strong>Year:</strong>
                    @Model.YearCreated
                </p>
            }


            @if (!string.IsNullOrEmpty(Model.Medium))
            {
                <p>
                    <strong>Medium:</strong>
                    @Model.Medium
                </p>
            }


            @if (Model.Category != null)
            {
                <p>
                    <strong>Category:</strong>
                    @Model.Category.Name
                </p>
            }


            @if (Model.Gallery != null)
            {
                <p>
                    <strong>Gallery:</strong>
                    @Model.Gallery.Name
                </p>
            }


            <!-- FAVOURITE BUTTON -->
            @if (Context.Session.GetString("UserId") != null)
            {
                <form asp-controller="Favourites"
                      asp-action="Add"
                      method="post"
                      class="mt-4">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="artworkId"
                           value="@Model.ArtworkId" />

                    <button type="submit"
                            class="btn btn-outline-danger btn-lg">

                         Add to Favourites

                    </button>

                </form>
            }
            else
            {
                <a asp-controller="Account"
                   asp-action="Login"
                   class="btn btn-outline-danger btn-lg mt-4">

                    Login to Add to Favourites

                </a>
            }


            <!-- BACK TO ARTWORKS -->

            <div class="mt-4">

                <a asp-controller="Artworks"
                   asp-action="Index"
                   class="btn btn-secondary">

                    ← Back to Artworks

                </a>

            </div>

        </div>

    </div>

</div>