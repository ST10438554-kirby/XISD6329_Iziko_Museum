@{
    ViewData["Title"] = "QR Artwork Lookup";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-md-8 col-lg-6">

            <div class="card shadow-sm border-0">

                <div class="card-body p-5 text-center">

                    <div style="font-size:60px;">
                        📱
                    </div>

                    <h1 class="mt-3">
                        QR Artwork Lookup
                    </h1>

                    <p class="text-muted">
                        Enter the artwork QR code to view
                        detailed information about the artwork.
                    </p>

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">
                            @ViewBag.Error
                        </div>
                    }

                    <form asp-controller="QR"
                          asp-action="Lookup"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div class="mb-3 text-start">

                            <label class="form-label">
                                Artwork QR Code
                            </label>

                            <input type="text"
                                   name="code"
                                   class="form-control form-control-lg"
                                   placeholder="Example: IZIKO-ART-001"
                                   required />

                        </div>

                        <button type="submit"
                                class="btn btn-primary btn-lg w-100">
                            Find Artwork
                        </button>

                    </form>

                    <hr class="my-4" />

                    <p class="small text-muted mb-0">
                        Scan or enter the code displayed
                        beside an Iziko artwork.
                    </p>

                </div>

            </div>

        </div>

    </div>

</div>