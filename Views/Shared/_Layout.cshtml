<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - Iziko Art Gallery
    </title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/IzikoMuseumWebsite.styles.css"
          asp-append-version="true" />

</head>


<body>


<!-- ========================= -->
<!-- NAVIGATION -->
<!-- ========================= -->

<header>

    <nav class="navbar navbar-expand-lg iziko-navbar">

        <div class="container">


            <!-- LOGO -->

           <a class="navbar-brand" asp-controller="Home" asp-action="Index">
    <img src="~/images/home/logo.jpg"
         alt="Iziko Art Gallery"
         class="museum-logo" />
</a>


            <!-- MOBILE BUTTON -->

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#mainNavigation"
                    aria-controls="mainNavigation"
                    aria-expanded="false"
                    aria-label="Toggle navigation">

                <span class="navbar-toggler-icon"></span>

            </button>


            <!-- NAVIGATION LINKS -->

            <div class="collapse navbar-collapse"
                 id="mainNavigation">


                <ul class="navbar-nav ms-auto">


                    <!-- HOME -->

                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Home"
                           asp-action="Index">

                            Home

                        </a>

                    </li>


                    <!-- ARTWORKS -->

                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Artworks"
                           asp-action="Index">

                            Artworks

                        </a>

                    </li>


                    <!-- ARTISTS -->

                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Artist"
                           asp-action="Index">

                            Artists

                        </a>

                    </li>


                    <!-- MULTIMEDIA -->

                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Multimedia"
                           asp-action="Index">

                            Multimedia

                        </a>

                    </li>


                    <!-- ABOUT -->

                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Home"
                           asp-action="About">

                            About

                        </a>

                    </li>


                    <!-- FAVOURITES -->

                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Favourites"
                           asp-action="Index">

                            ♡ Favourites

                        </a>

                    </li>


                    <!-- LOGIN -->

                    <li class="nav-item">

                        <a class="nav-link login-link"
                           asp-controller="Account"
                           asp-action="Login">

                            Login

                        </a>

                    </li>

                </ul>

            </div>

        </div>

    </nav>

</header>


<!-- ========================= -->
<!-- PAGE CONTENT -->
<!-- ========================= -->

<div>

    <main role="main">

        @RenderBody()

    </main>

</div>


<!-- ========================= -->
<!-- FOOTER -->
<!-- ========================= -->

<footer class="iziko-footer">

    <div class="container">

        <div class="footer-content">


            <div>

                <h3>
                    Iziko Art Gallery
                </h3>

                <p>
                    Discover South African, African
                    and international art in Cape Town.
                </p>

            </div>


            <div>

                <p>
                    Government Avenue,
                    Company's Garden,
                    Cape Town
                </p>

                <p>
                    Tel: +27 (0) 21 481 3970
                </p>

            </div>

        </div>


        <div class="footer-bottom">

            &copy; 2026 Iziko Art Gallery

        </div>

    </div>

</footer>


<!-- ========================= -->
<!-- SCRIPTS -->
<!-- ========================= -->

<script src="~/lib/jquery/dist/jquery.min.js"></script>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

<script src="~/js/site.js"
        asp-append-version="true"></script>

@await RenderSectionAsync("Scripts",
                         required: false)

</body>

</html>