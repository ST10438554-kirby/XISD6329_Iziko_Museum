@model IEnumerable<IzikoMuseumWebsite.Models.Favourite>

@{
    ViewData["Title"] = "My Favourites";
}

<div class="container py-5">

    <div class="text-center mb-5">

        <h1 class="display-5 fw-bold">
             My Favourite Artworks
        </h1>

        <p class="text-muted">
            Your saved artworks.
        </p>

    </div>


    @if (Model != null && Model.Any())
    {
        <div class="row g-4">

            @foreach (var favourite in Model)
            {
                <div class="col-md-6 col-lg-4">

                    <div class="card h-100 shadow-sm">


                        @if (favourite.Artwork != null &&
                             !string.IsNullOrEmpty(favourite.Artwork.ImageUrl))
                        {
                            <img src="@favourite.Artwork.ImageUrl"
                                 class="card-img-top"
                                 alt="@favourite.Artwork.Title"
                                 style="height:250px; object-fit:cover;" />
                        }
                        else
                        {
                            <div class="d-flex align-items-center justify-content-center bg-light"
                                 style="height:250px;">

                                <span class="text-muted">
                                    No image available
                                </span>

                            </div>
                        }


                        <div class="card-body d-flex flex-column">

                            @if (favourite.Artwork != null)
                            {
                                <h5 class="card-title">
                                    @favourite.Artwork.Title
                                </h5>


                                @if (favourite.Artwork.Artist != null)
                                {
                                    <p class="text-muted">
                                        By @favourite.Artwork.Artist.Name
                                    </p>
                                }


                                <!-- VIEW ARTWORK -->

                                <a asp-controller="Artworks"
                                   asp-action="Details"
                                   asp-route-id="@favourite.Artwork.ArtworkId"
                                   class="btn btn-primary mb-2">

                                    View Artwork

                                </a>


                                <!-- REMOVE -->

                                <form asp-controller="Favourites"
                                      asp-action="Remove"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="artworkId"
                                           value="@favourite.Artwork.ArtworkId" />

                                    <button type="submit"
                                            class="btn btn-outline-danger w-100">

                                        Remove from Favourites

                                    </button>

                                </form>
                            }

                        </div>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <div class="text-center py-5">

            <h3>You don't have any favourites yet.</h3>

            <p class="text-muted">
                Browse the artwork collection and save your favourite pieces.
            </p>


            <a asp-controller="Artworks"
               asp-action="Index"
               class="btn btn-primary">

                Explore Artworks

            </a>

        </div>
    }

</div>