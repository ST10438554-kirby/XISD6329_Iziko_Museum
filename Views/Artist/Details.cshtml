@model IzikoMuseumWebsite.Models.Artist

@{
    ViewData["Title"] = Model.Name;
}

<style>
    .artist-details-page {
        background: #f7f4ef;
        min-height: 100vh;
        padding: 60px 7%;
    }

    .artist-details-container {
        max-width: 1100px;
        margin: auto;
        background: white;
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 8px 30px rgba(0,0,0,0.08);
    }

    .artist-hero {
        display: grid;
        grid-template-columns: 40% 60%;
    }

    .artist-hero-image {
        width: 100%;
        height: 500px;
        object-fit: cover;
        background: #e7e1d8;
        display: block;
    }

    .artist-placeholder {
        width: 100%;
        height: 500px;
        background: #e7e1d8;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #8d857a;
        font-size: 18px;
    }

    .artist-info {
        padding: 55px;
    }

    .artist-label {
        color: #b27a3c;
        font-size: 13px;
        font-weight: bold;
        letter-spacing: 3px;
        text-transform: uppercase;
    }

    .artist-info h1 {
        font-size: 48px;
        color: #222;
        margin: 15px 0;
    }

    .artist-meta {
        color: #777;
        margin-bottom: 30px;
        font-size: 15px;
    }

    .artist-biography {
        color: #555;
        font-size: 17px;
        line-height: 1.9;
        white-space: pre-line;
    }

    .back-button {
        display: inline-block;
        margin-top: 30px;
        padding: 12px 22px;
        background: #b27a3c;
        color: white;
        text-decoration: none;
        border-radius: 5px;
        font-weight: 600;
    }

        .back-button:hover {
            background: #8f5f2e;
            color: white;
        }

    @@media (max-width: 800px) {

        .artist-hero {
            grid-template-columns: 1fr;
        }

        .artist-hero-image,
        .artist-placeholder {
            height: 350px;
        }

        .artist-info {
            padding: 30px;
        }

            .artist-info h1 {
                font-size: 36px;
            }
    }
</style>

<div class="artist-details-page">

    <div class="artist-details-container">

        <div class="artist-hero">

            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl"
                     alt="@Model.Name"
                     class="artist-hero-image" />
            }
            else
            {
                <div class="artist-placeholder">
                    Artist Image
                </div>
            }

            <div class="artist-info">

                <div class="artist-label">
                    South African Artist
                </div>

                <h1>
                    @Model.Name
                </h1>

                <div class="artist-meta">

                    @if (Model.BirthYear.HasValue)
                    {
                        <span>Born @Model.BirthYear</span>
                    }

                    @if (Model.DeathYear.HasValue)
                    {
                        <span> – @Model.DeathYear</span>
                    }

                    @if (!string.IsNullOrEmpty(Model.Nationality))
                    {
                        <span> · @Model.Nationality</span>
                    }

                </div>

                <div class="artist-biography">
                    @Model.Biography
                </div>

                <a asp-controller="Artist"
                   asp-action="Index"
                   class="back-button">
                    ← Back to Artists
                </a>

            </div>

        </div>

    </div>

</div>