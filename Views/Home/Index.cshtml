<!-- ============================= -->
<!-- VISIT SECTION -->
<!-- ============================= -->

<section id="visit" class="visit-section">

    <div class="container">

        <div class="section-heading">

            <span>PLAN YOUR VISIT</span>

            <h2>
                Hours, Fees & Visitor Information
            </h2>

            <p>
                Everything you need to plan your visit to the gallery.
            </p>

        </div>


        <div class="visit-grid">

            <!-- HOURS -->

            <div class="visit-card">

                <div class="visit-card-icon">
                    🕐
                </div>

                <h3>
                    Hours
                </h3>

                <div class="visit-card-content">

                    <h4>
                        Winter Weekend Hours
                    </h4>

                    <p>
                        <strong>Saturdays:</strong>
                        08h30 – 16h00
                    </p>

                    <p>
                        <strong>Sundays:</strong>
                        08h30 – 16h00
                    </p>

                    <hr />

                    <p>
                        <strong>Monday – Sunday:</strong>
                        09h00 – 17h00
                    </p>

                    <p class="small-note">
                        Closed on Christmas Day and Workers' Day.
                    </p>

                </div>

            </div>


            <!-- INTERNATIONAL FEES -->

            <div class="visit-card">

                <div class="visit-card-icon">
                    🌍
                </div>

                <h3>
                    International Fee
                </h3>

                <div class="price-list">

                    <div>
                        <span>Adults</span>
                        <strong>R100</strong>
                    </div>

                    <div>
                        <span>Children aged 5–17</span>
                        <strong>R100</strong>
                    </div>

                    <div>
                        <span>Pensioners & Students</span>
                        <strong>R100</strong>
                    </div>

                </div>

            </div>


            <!-- LOCAL FEES -->

            <div class="visit-card">

                <div class="visit-card-icon">
                    🇿🇦
                </div>

                <h3>
                    Local Fee
                </h3>

                <div class="price-list">

                    <div>
                        <span>Adults</span>
                        <strong>R60</strong>
                    </div>

                    <div>
                        <span>Children aged 5–17</span>
                        <strong>R40</strong>
                    </div>

                    <div>
                        <span>South African pensioners</span>
                        <strong>R40</strong>
                    </div>

                    <div>
                        <span>Students with valid cards</span>
                        <strong>R40</strong>
                    </div>

                </div>

                <p class="free-entry">
                    Free entry on Fridays
                </p>

            </div>

        </div>


        <!-- TICKETS -->

        <div class="ticket-box">

            <div>

                <span>
                    READY TO VISIT?
                </span>

                <h3>
                    Get your tickets online
                </h3>

            </div>

            <a href="https://www.webtickets.co.za/v2/event.aspx?itemid=1527309559"
               target="_blank"
               rel="noopener noreferrer"
               class="museum-btn primary-btn">

                Get Your Tickets

            </a>

        </div>

    </div>

</section>


