@{
    ViewData["Title"] = "Home";
}

<!-- ============================= -->
<!-- HERO SECTION -->
<!-- ============================= -->

<section class="museum-hero">

    <div class="hero-overlay">

        <div class="container">

            <div class="hero-content">

                <p class="hero-subtitle">
                    WELCOME TO 
                </p>

                <h1>
                    The Iziko 
                    <span>Art Gallery</span>
                </h1>

                <p class="hero-text">
                    Discover South African, African and International
                    art in the heart of Cape Town.
                </p>

                <div class="hero-buttons">

                    <a asp-controller="Artworks"
                       asp-action="Index"
                       class="museum-btn primary-btn">

                        Explore Artworks

                    </a>

                    <a href="#visit"
                       class="museum-btn secondary-btn">

                        Plan Your Visit

                    </a>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- ============================= -->
<!-- WELCOME SECTION -->
<!-- ============================= -->

<section class="welcome-section">

    <div class="container">

        <div class="section-heading">

            <span>DISCOVER • EXPERIENCE • LEARN</span>

            <h2>
                Welcome to the Iziko Art Gallery
            </h2>

        </div>


        <div class="welcome-grid">

            <div class="welcome-text">

                <p>
                    The renowned public art museum in the Mother City
                    is home to a sizable and fascinating collection of
                    South African, African, and international historical,
                    modern, and contemporary artworks.
                </p>

                <p>
                    To enable the museum to provide a comprehensive
                    program of temporary exhibitions of paintings,
                    works on paper, photography, sculpture, beadwork,
                    textiles, and architecture, selections from the
                    Permanent Collection are rotated on a regular basis.
                </p>

                <p>
                    These exhibitions reveal the remarkable variety
                    of artistic expression in South Africa, across the
                    African continent and beyond.
                </p>

                <a asp-controller="Artworks"
                   asp-action="Index"
                   class="text-link">

                    Explore the Collection →

                </a>

            </div>


            <div class="welcome-highlight">

                <div class="highlight-icon">
                    🖼️
                </div>

                <h3>
                    A World of Art
                </h3>

                <p>
                    Explore historical, modern and contemporary
                    artworks from South Africa, Africa and beyond.
                </p>

            </div>

        </div>

    </div>

</section>


