@{
    ViewData["Title"] = "Multimedia";
}

<div class="container py-5">

    <div class="text-center">

        <p class="text-uppercase">
            Discover & Learn
        </p>

        <h1 class="display-4">
            Multimedia
        </h1>

        <p class="lead">
            Explore videos, virtual experiences and
            educational content from Iziko Museums.
        </p>

    </div>

    <div class="row mt-5">

        <div class="col-md-4 mb-4">

            <div class="card h-100 shadow-sm">

                <div class="card-body text-center">

                    <h3>
                        Museum Tours
                    </h3>

                    <p>
                        Explore the museum through
                        digital experiences and tours.
                    </p>

                    <button class="btn btn-primary"
                            onclick="showMessage()">

                        Watch Now

                    </button>

                </div>

            </div>

        </div>


        <div class="col-md-4 mb-4">

            <div class="card h-100 shadow-sm">

                <div class="card-body text-center">

                    <h3>
                        Art & Culture
                    </h3>

                    <p>
                        Learn about South African art,
                        culture and heritage.
                    </p>

                    <button class="btn btn-primary"
                            onclick="showMessage()">

                        Watch Now

                    </button>

                </div>

            </div>

        </div>


        <div class="col-md-4 mb-4">

            <div class="card h-100 shadow-sm">

                <div class="card-body text-center">

                    <h3>
                        Educational Content
                    </h3>

                    <p>
                        Discover educational resources
                        about the museum collections.
                    </p>

                    <button class="btn btn-primary"
                            onclick="showMessage()">

                        Watch Now

                    </button>

                </div>

            </div>

        </div>

    </div>


    <div class="text-center mt-5">

        <h2>
            Scan & Discover
        </h2>

        <p>
            Scan QR codes around the museum to access
            additional artwork information and multimedia.
        </p>

        <div class="border p-5 mx-auto"
             style="max-width: 250px;">

            <strong>
                QR CODE
            </strong>

        </div>

    </div>

</div>


<script>

    function showMessage() {

        alert(
            "Multimedia content will be available here."
        );

    }

</script>